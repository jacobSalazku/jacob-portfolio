# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Sanity project, also used by Studio (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# GraphQL endpoint of the deployed Sanity API (required, the build fails without it)
# https://<projectId>.api.sanity.io/v2025-02-19/graphql/<dataset>/default
SANITY_GRAPHQL_URL=

# Read token, only needed when the dataset is private
SANITY_API_READ_TOKEN=

# Public address of the site, used for metadata and the social image.
# Without it localhost is used.
NEXT_BASE_URL=http://localhost:3000

# Optional: different links for the resume (default /resume-nl.pdf and /resume-en.pdf)
NEXT_PUBLIC_RESUME_NL=
NEXT_PUBLIC_RESUME_EN=
